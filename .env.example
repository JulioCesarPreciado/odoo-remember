# Conexión a Odoo (obligatorias)
ODOO_HOST="tu-empresa.odoo.com"
ODOO_DB="nombre-de-la-base"
ODOO_USER="tu-correo@empresa.com"
# API key de Odoo: Preferencias → Seguridad de la cuenta → Nueva clave API
ODOO_TOKEN=""

# API local
# API_PORT=8787

# Recordatorios
# REMINDER_START=08:00
# CHECKOUT_REMINDER_START=18:00
# REMINDER_INTERVAL_MIN=10
# WORK_DAYS=1-5

# Hora de comida
# LUNCH_WINDOW_START=14:00
# LUNCH_WINDOW_END=16:00
# LUNCH_MINUTES=60

# Ubicación
# REQUIRE_LOCATION=true
# LOCATION_MAX_AGE_MIN=15
